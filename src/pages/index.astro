---
import "../styles/index.css";

import { getCollection, getEntry, render } from "astro:content";
import { name, openGraph } from "spectre:globals";
import ProfilePicture from "../assets/logo.png";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import ImageGlow from "../components/ImageGlow.astro";
import Layout from "../layouts/Layout.astro";

const [posts, projects, about, workExperience, quickInfo] = await Promise.all([
	getCollection("posts", (post) => post.data.draft !== true),
	getCollection("projects"),
	getEntry("other", "about"),
	getCollection("workExperience"),
	getCollection("quickInfo"),
]);

const { Content: About } = await render(about!);
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	pagefindIgnore
>
	<div class="layout-grid-left" slot="left">
		<Card class="flex-col-card">
			<button
				type="button"
				class="profile-picture-trigger"
				id="profile-picture-trigger"
				aria-label="Unlock the profile picture easter egg"
			>
				<ImageGlow
					quality={100}
					height={120}
					src={ProfilePicture}
					alt="An I inscribed in a BGA landing pattern"
					loading="eager"
				/>
			</button>
			<h2>{name}</h2>
			<ul class="overview-list">
				{
					quickInfo.map((info) => (
						<li>
							{info.data.link ? (
								<a href={info.data.link} class="info-link">
									<Icon
										name={info.data.icon}
										width={24}
										height={24}
										class="glow-icon"
									/>
									<span>{info.data.text}</span>
								</a>
							) : (
								<>
									<Icon
										name={info.data.icon}
										width={24}
										height={24}
										class="glow-icon"
									/>
									<span>{info.data.text}</span>
								</>
							)}
						</li>
					))
				}
			</ul>
		</Card>
	</div>
	<div class="layout-grid-right" slot="right">
		<Card>
			<div class="header-container">
				<Icon
					name="user"
					width={24}
					height={24}
					class="glow-icon"
				/>
				<h2>About me</h2>
			</div>
			<div class="prose">
				<About />
			</div>
		</Card>
		<Card>
			<div class="header-container">
				<Icon
					name="rss"
					width={24}
					height={24}
					class="glow-icon"
				/>
				<h2>Latest Posts</h2>
			</div>
			<div class="content-container">
				{
					posts
						.sort(
							(a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
						)
						.slice(0, 2)
						.map((post) => (
							<a href={`/blog/${post.id}`} class="post-container">
								<div class="post-header">
									<h3>{post.data.title}</h3>
									<span class="post-date">
										{post.data.createdAt.toLocaleDateString()}
									</span>
								</div>
								<span>{post.data.description}</span>
							</a>
						))
				}
			</div>
		</Card>
		<Card>
			<div class="header-container">
				<Icon
					name="folder-git"
					width={24}
					height={24}
					class="glow-icon"
				/>
				<h2>Latest Projects</h2>
			</div>
			<div class="content-container">
				{
					projects
						.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
						.slice(0, 2)
						.map((project) => (
							<a href={`/projects/${project.id}`} class="post-container">
								<div class="post-header">
									<h3>{project.data.title}</h3>
									<span class="post-date">
										{project.data.date.toLocaleDateString()}
									</span>
								</div>
								<span>{project.data.description}</span>
							</a>
						))
				}
			</div>
		</Card>
		<Card>
			<div class="header-container">
				<Icon
					name="briefcase-business"
					width={24}
					height={24}
					class="glow-icon"
				/>
				<h2>Work Experience</h2>
			</div>
			<div class="work-experience-container">
				{
					workExperience.reverse().map((entry) => (
						<div class="work-experience-entry">
							<span class="work-experience-duration">
								{entry.data.duration}
							</span>
							<h3 class="work-experience-company">{entry.data.company}</h3>
							<span class="work-experience-role">{entry.data.title}</span>
							<p class="work-experience-desc">{entry.data.description}</p>
						</div>
					))
				}
			</div>
		</Card>
	</div>
</Layout>

<script>
	interface PageBackgroundController {
		enableHoverEasterEgg: () => void;
	}

	const unlockThreshold = 5;
	let clickCount = 0;
	let unlocked = false;

	const getPageBackground = () => {
		return (window as Window & { pageBackground?: PageBackgroundController })
			.pageBackground;
	};

	const enableEasterEgg = () => {
		if (unlocked) {
			return;
		}

		const background = getPageBackground();

		if (!background) {
			window.addEventListener(
				"page-background:ready",
				(event) => {
					const readyEvent = event as CustomEvent<PageBackgroundController>;
					readyEvent.detail.enableHoverEasterEgg();
				},
				{ once: true },
			);
		} else {
			background.enableHoverEasterEgg();
		}

		unlocked = true;
	};

	const profilePictureTrigger = document.getElementById("profile-picture-trigger");

	profilePictureTrigger?.addEventListener("click", () => {
		if (unlocked) {
			return;
		}

		clickCount += 1;

		if (clickCount >= unlockThreshold) {
			enableEasterEgg();
		}
	});
</script>
