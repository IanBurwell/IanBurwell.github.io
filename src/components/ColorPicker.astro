---
import Icon from "./Icon.astro";
---

<div id="color-picker-wrapper">
	<button id="color-picker-toggle">
		<Icon name="palette" width={18} height={18} viewBox="0 0 24 24" />
	</button>
	<div id="color-picker-popup">
		<label for="color-input">Theme Color</label>
		<input type="color" id="color-input" />
		<button id="color-reset">Reset</button>
	</div>
</div>

<style>
	#color-picker-wrapper {
		position: fixed;
		bottom: 0.5rem;
		left: 0.5rem;
		z-index: 100;
	}

	#color-picker-toggle {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border-radius: 50%;
		background-color: #121212;
		border: 1px solid #353535;
		color: var(--primary);
		cursor: pointer;
	}

	#color-picker-toggle :global(svg) {
		display: block;
		flex-shrink: 0;
		overflow: visible;
	}

	#color-picker-toggle:hover {
		border-color: var(--primary);
		filter: drop-shadow(0 0 6px var(--primary));
	}

	#color-picker-popup {
		display: none;
		flex-direction: column;
		gap: 0.625rem;
		position: absolute;
		bottom: calc(100% + 0.5rem);
		left: 0;
		background-color: #121212;
		border: 1px solid #353535;
		padding: 0.875rem;
		min-width: 160px;
	}

	#color-picker-popup.open {
		display: flex;
	}

	#color-picker-popup label {
		font-size: 0.75rem;
		color: #c7c7c7;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	#color-input {
		width: 100%;
		height: 36px;
		border: 1px solid #353535;
		background: transparent;
		cursor: pointer;
		padding: 2px;
	}

	#color-input::-webkit-color-swatch-wrapper {
		padding: 0;
	}

	#color-input::-webkit-color-swatch {
		border: none;
	}

	#color-input::-moz-color-swatch {
		border: none;
	}

	#color-reset {
		background: none;
		border: 1px solid #353535;
		color: #c7c7c7;
		padding: 0.375rem 0.5rem;
		font-size: 0.75rem;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	#color-reset:hover {
		border-color: var(--primary);
		color: #fff;
	}
</style>

<script is:inline>
	(function () {
		const DEFAULT_PRIMARY = "#8c5cf5";
		const STORAGE_KEY = "spectre-theme-color";

		function hexToRgb(hex) {
			const r = parseInt(hex.slice(1, 3), 16);
			const g = parseInt(hex.slice(3, 5), 16);
			const b = parseInt(hex.slice(5, 7), 16);
			return { r, g, b };
		}

		function hexToHsl(hex) {
			const { r, g, b } = hexToRgb(hex);
			const rn = r / 255;
			const gn = g / 255;
			const bn = b / 255;
			const max = Math.max(rn, gn, bn);
			const min = Math.min(rn, gn, bn);
			let h = 0;
			let s = 0;
			const l = (max + min) / 2;

			if (max !== min) {
				const d = max - min;
				s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
				if (max === rn) h = ((gn - bn) / d + (gn < bn ? 6 : 0)) / 6;
				else if (max === gn) h = ((bn - rn) / d + 2) / 6;
				else h = ((rn - gn) / d + 4) / 6;
			}
			return { h: h * 360, s: s * 100, l: l * 100 };
		}

		function hslToHex(h, s, l) {
			s /= 100;
			l /= 100;
			const a = s * Math.min(l, 1 - l);
			const f = (n) => {
				const k = (n + h / 30) % 12;
				const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
				return Math.round(255 * color)
					.toString(16)
					.padStart(2, "0");
			};
			return "#" + f(0) + f(8) + f(4);
		}

		function applyColor(hex) {
			const root = document.documentElement;
			const { r, g, b } = hexToRgb(hex);
			const { h, s, l } = hexToHsl(hex);

			const lightHex = hslToHex(h, Math.min(s + 10, 100), Math.min(l + 10, 100));
			const lightestHex = hslToHex(h, Math.min(s + 5, 100), Math.min(l + 22, 100));

			root.style.setProperty("--primary", hex);
			root.style.setProperty("--primary-rgb", r + ", " + g + ", " + b);
			root.style.setProperty("--primary-light", lightHex);
			root.style.setProperty("--primary-lightest", lightestHex);

			// Update background animation if it's running
			if (window.pageBackground) {
				window.pageBackground.primaryRgb = r + ", " + g + ", " + b;
			}
		}

		// Apply saved color on load (before interaction)
		const saved = localStorage.getItem(STORAGE_KEY);
		if (saved) {
			applyColor(saved);
		}

		// Wire up UI after DOM is ready
		function init() {
			const toggle = document.getElementById("color-picker-toggle");
			const popup = document.getElementById("color-picker-popup");
			const input = document.getElementById("color-input");
			const reset = document.getElementById("color-reset");

			if (!toggle || !popup || !input || !reset) return;

			// Set input to current color
			const current = localStorage.getItem(STORAGE_KEY) || DEFAULT_PRIMARY;
			input.value = current;

			toggle.addEventListener("click", function (e) {
				e.stopPropagation();
				popup.classList.toggle("open");
			});

			input.addEventListener("input", function () {
				applyColor(input.value);
				localStorage.setItem(STORAGE_KEY, input.value);
			});

			reset.addEventListener("click", function () {
				input.value = DEFAULT_PRIMARY;
				applyColor(DEFAULT_PRIMARY);
				localStorage.removeItem(STORAGE_KEY);
			});

			document.addEventListener("click", function (e) {
				if (!popup.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
					popup.classList.remove("open");
				}
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>
